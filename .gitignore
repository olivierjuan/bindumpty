# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
# uv.lock: untracked until dependencies are frozen (M0), then remove this line
uv.lock
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Local databases and run artifacts (never in git)
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
.llm_cache/
runs/
artifacts/

# Fuzzing (horses)
horses/corpus/**
!horses/corpus/.gitkeep
*.sancov
*.hn
.afl/
# libFuzzer crash artifacts (written to cwd; reproducible from the corpus)
/crash-*
/leak-*
/timeout-*
/horses/src/crash-*
/horses/src/leak-*
/horses/src/timeout-*
# Spike build outputs (source + drivers are committed; binaries regenerate)
horses/spikes/out/
# Vendored third-party: keep source + pins, ignore build trees
horses/third_party/**/build/
horses/third_party/**/build-*/
horses/third_party/**/_deps/

# Toy binaries: keep sources + build recipes, ignore the build outputs and
# generated trace bundles (regenerated by build.sh / record.sh).
toys/**/build/
toys/**/ground_truth/traces.jsonl

# Ghidra / analysis exports
analysis/exports/
ghidra_projects/

# OS / editor
.DS_Store
*.swp
ghidra_12.2_PUBLIC_20261016.zip
# rizin backend: static binary dist (pinned in analysis/rizin/PIN.txt)
analysis/rizin/dist/
docs/_site/
